rules_version = '2';

// ============================================================================
// Assumed Data Model (ChildGuard - child-guard-e0744)
// ============================================================================
// Collection: families/{familyDocId}
//   - Document ID: family_<PIN> matching ^family_[A-Za-z0-9_-]{12,24}$
//   - Access: Shared secret PIN capability model (no login screen) for
//     two partners' iPhones and Cloudflare Pages Functions REST API.
//     List queries and deletes are explicitly blocked.
//   - Required fields: coupleStatus, pickupToday, savedPlaces (<=20), history (<=50)
//   - Optional fields: dayKey (<=16), profiles, updatedAt (ts/str<=64), pinConfigured (bool)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidFamilyDocId(familyDocId) {
      return familyDocId.matches('^family_[A-Za-z0-9_-]{12,24}$');
    }

    function isValidProfiles(p) {
      return p is map &&
        p.keys().hasOnly(['myName', 'partnerName', 'guestName']) &&
        (!('myName' in p) || (p.myName is string && p.myName.size() <= 64)) &&
        (!('partnerName' in p) || (p.partnerName is string && p.partnerName.size() <= 64)) &&
        (!('guestName' in p) || (p.guestName is string && p.guestName.size() <= 64));
    }

    function isValidCoupleStatus(cs) {
      return cs is map &&
        cs.keys().hasAll(['state']) &&
        cs.keys().hasOnly([
          'state', 'driverName', 'statusText', 'updatedAt',
          'lastVerifiedAt', 'soloContinueUntil', 'snoozeUntil', 'refuelUntil',
          'droppedOffAtDaycareToday', 'brokenRoutineAlert', 'tempC', 'savedVolumePct',
          'originPlaceId'
        ]) &&
        cs.state is string && cs.state.size() > 0 && cs.state.size() <= 40 &&
        (!('driverName' in cs) || (cs.driverName is string && cs.driverName.size() <= 80)) &&
        (!('statusText' in cs) || (cs.statusText is string && cs.statusText.size() <= 300)) &&
        (!('originPlaceId' in cs) || (cs.originPlaceId is string && cs.originPlaceId.size() <= 48));
    }

    function isValidPickupToday(pt) {
      return pt is map &&
        pt.keys().hasAll(['assignee']) &&
        pt.keys().hasOnly(['assignee', 'updatedAt', 'updatedBy']) &&
        pt.assignee is string && pt.assignee.size() > 0 && pt.assignee.size() <= 64 &&
        (!('updatedBy' in pt) || (pt.updatedBy is string && pt.updatedBy.size() <= 80));
    }

    function isValidSavedPlaces(places) {
      return places is list &&
        places.size() <= 20 &&
        (places.size() == 0 || (
          places[0] is map &&
          places[0].keys().hasAll(['id', 'name', 'lat', 'lon']) &&
          places[0].keys().hasOnly(['id', 'icon', 'name', 'address', 'lat', 'lon', 'radiusM']) &&
          places[0].id is string && places[0].id.size() <= 48 &&
          places[0].name is string && places[0].name.size() <= 64 &&
          places[0].lat is number && places[0].lat >= -90 && places[0].lat <= 90 &&
          places[0].lon is number && places[0].lon >= -180 && places[0].lon <= 180
        ));
    }

    function isValidHistory(history) {
      return history is list &&
        history.size() <= 50 &&
        (history.size() == 0 || (
          history[0] is map &&
          history[0].keys().hasAll(['id', 'endedAt', 'outcome']) &&
          history[0].keys().hasOnly([
            'id', 'endedAt', 'driverName', 'method',
            'reason', 'maxSpeedKmh', 'children', 'outcome'
          ]) &&
          history[0].id is string && history[0].id.size() <= 48 &&
          history[0].outcome is string && history[0].outcome in ['EMPTY', 'DAYCARE_SOLO']
        ));
    }

    function isValidFamilyDoc(data) {
      return data.keys().hasAll(['coupleStatus', 'pickupToday', 'savedPlaces', 'history']) &&
        data.keys().hasOnly([
          'dayKey', 'profiles', 'coupleStatus', 'pickupToday',
          'savedPlaces', 'history', 'updatedAt', 'pinConfigured'
        ]) &&
        (!('dayKey' in data) || (data.dayKey is string && data.dayKey.size() <= 16)) &&
        (!('profiles' in data) || isValidProfiles(data.profiles)) &&
        isValidCoupleStatus(data.coupleStatus) &&
        isValidPickupToday(data.pickupToday) &&
        isValidSavedPlaces(data.savedPlaces) &&
        isValidHistory(data.history) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('pinConfigured' in data) || data.pinConfigured is bool);
    }

    match /families/{familyDocId} {
      allow get: if isValidFamilyDocId(familyDocId);
      allow list: if false;
      allow create, update: if isValidFamilyDocId(familyDocId) &&
        isValidFamilyDoc(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
